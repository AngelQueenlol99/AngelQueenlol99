    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst now = Date.now();\nconst items = $input.all().map(i=>i.json);\nconst seen = new Set();\nconst terms = /\\b(ai|artificial intelligence|chips?|semiconductors?|memory|hbm|ipos?|anthropic|openai|nvidia|amd|tsmc|microsoft|alphabet|google|amazon|meta|oracle|starlink|spacex|cyber\\w*|cloud|fed|inflation|bonds?|yields?|markets?|stocks?|earnings|telecom|oil|tariffs?|mergers?|acquisitions?|private equity|venture)\\b/i;\nconst ts = s => { const t = Date.parse(s); return Number.isNaN(t) ? 0 : t; };\nconst stories = items.map(x=>({\n title: String(x.title||'').trim(),\n link: x.link||x.guid||'',\n published: x.isoDate||x.pubDate||'',\n summary: String(x.contentSnippet||x.content||'').replace(/<[^>]*>/g,'').slice(0,450)\n})).filter(x=>x.title && x.link && (!x.published || now-Date.parse(x.published)<1000*60*60*96))\n .filter(x=>{let k=x.title.toLowerCase().replace(/[^a-z0-9]/g,'').slice(0,85);if(seen.has(k))return false;seen.add(k);return true;})\n .sort((a,b)=>Number(terms.test(b.title))-Number(terms.test(a.title)) || ts(b.published)-ts(a.published))\n .slice(0,45);\nreturn [{json:{stories, generatedAt:new Date().toISOString(), note:'RSS headlines and snippets are leads, not independently verified full articles.'}}];\n"
      },
