    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst snapshot=$('Render Snapshot PDF').first().binary?.data;\nconst intelligence=$('Render Intelligence PDF').first().binary?.data;\nif(!snapshot||!intelligence) throw new Error('Both PDF renderings must succeed before email is sent');\nsnapshot.fileName='Martha_Market_Snapshot.pdf';\nintelligence.fileName='Martha_Market_Intelligence.pdf';\nreturn [{json:{to:'angelikabell10@gmail.com',subject:'Martha 2.0 | Daily Market Briefs | '+new Date().toLocaleDateString('en-US',{timeZone:'America/New_York'}),body:'Good morning! Attached are your 2-page Martha Market Snapshot and your 5–6-page Market Intelligence Report. Quotes are timestamped within the reports; markets may be closed or premarket.'},binary:{snapshot,intelligence}}];\n"
      },
